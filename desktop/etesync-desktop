#!/usr/bin/env bash
# Opens EteSync Desktop: starts its server when it isn't running (when it's installed without the
# service, or not installed at all, run from an unpacked release), then opens the app's window.
#
#   ./etesync-desktop            # open it
#   ./etesync-desktop --start    # only start the server
#   ./etesync-desktop --stop     # stop the server this started (not the service's)
#   ./etesync-desktop --status   # whether its server runs: "ours", "other" (another program has the port) or "none"
#
# The settings install.sh chose (PORT, BROWSER, LOW_MEMORY, PROFILE) are in the settings file next to this,
# and can also be given as environment variables. A server this starts keeps running in the
# background (until --stop, or the computer is turned off), so the window opens at once the next time.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# (environment variables first, then the settings)
given_port="${PORT:-}" given_browser="${BROWSER:-}" given_low_memory="${LOW_MEMORY:-}" given_profile="${PROFILE:-}"
# shellcheck source=/dev/null
[ -f "$HERE/settings" ] && . "$HERE/settings"
PORT="${given_port:-${PORT:-8092}}"
BROWSER="${given_browser:-${BROWSER:-}}"
LOW_MEMORY="${given_low_memory:-${LOW_MEMORY:-1}}"
# "own": the window opens in a browser profile of its own (in profile/ next to this, profile-firefox/
# for Firefox), without extensions and with the permissions it doesn't need turned off, and the
# server opens its links in the default browser. "shared": in the browser's usual profile.
PROFILE="${given_profile:-${PROFILE:-own}}"
URL="http://localhost:$PORT"
PID_FILE="$HERE/serve.pid"
PROFILE_DIR="$HERE/profile"
FIREFOX_PROFILE_DIR="$HERE/profile-firefox"
server_options=()
[ "$PROFILE" = "own" ] && server_options=(--open-links)

# Whether this app's server answers on the port (see --status)
server() {
    python3 - "$URL/" <<'PY'
import sys, urllib.error, urllib.request
try:
    response = urllib.request.urlopen(sys.argv[1], timeout=2)
except urllib.error.HTTPError as e:
    response = e
except OSError:
    print("none")
    sys.exit()
print("ours" if (response.headers.get("Server") or "").startswith("EteSyncDesktop") else "other")
PY
}

start() {
    case "$(server)" in
        ours) return ;;
        other)
            echo "Another program uses port $PORT. Install EteSync Desktop on another one, e.g.: PORT=8093 ./install.sh" >&2
            exit 1 ;;
    esac
    command -v python3 >/dev/null 2>&1 || { echo "Missing python3, it's needed to run EteSync Desktop" >&2; exit 1; }
    # (setsid: in a session of its own, so that it keeps running when the terminal or menu that
    # started this goes away)
    setsid python3 "$HERE/serve.py" --port "$PORT" --dir "$HERE/site" --reminders "$HERE/reminders.json" "${server_options[@]}" >> "$HERE/serve.log" 2>&1 < /dev/null &
    echo $! > "$PID_FILE"
    for _ in $(seq 1 20); do
        [ "$(server)" = "ours" ] && return
        sleep 0.5
    done
    echo "EteSync Desktop's server didn't start, see $HERE/serve.log" >&2
    exit 1
}

stop() {
    if [ -f "$PID_FILE" ] && kill "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "Stopped EteSync Desktop's server"
    elif [ "$(server)" = "ours" ]; then
        echo "EteSync Desktop runs as a service, stop it with: systemctl --user stop etesync-aio-web"
    fi
    rm -f "$PID_FILE"
}

# The profile of the app's window (see PROFILE), made the first time. It turns off what the app doesn't
# use: the permissions it never asks for (so that nothing can be granted by mistake), saving passwords
# and other form data, and what would send the decrypted text to Google (translating, and the spell
# checking of Google's service; the browser's own still works).
make_profile() {
    [ -f "$PROFILE_DIR/Default/Preferences" ] && return
    mkdir -p "$PROFILE_DIR/Default"
    chmod 700 "$PROFILE_DIR"
    cat > "$PROFILE_DIR/Default/Preferences" <<'JSON'
{
  "profile": {
    "default_content_setting_values": {
      "notifications": 2, "geolocation": 2, "media_stream_mic": 2, "media_stream_camera": 2,
      "midi_sysex": 2, "sensors": 2, "usb_guard": 2, "serial_guard": 2, "hid_guard": 2,
      "bluetooth_guard": 2, "bluetooth_scanning": 2, "idle_detection": 2, "window_placement": 2,
      "local_fonts": 2, "protocol_handlers": 2, "payment_handler": 2, "ar": 2, "vr": 2,
      "clipboard": 2, "file_system_write_guard": 2, "local_network_access": 2, "local_network": 2,
      "loopback_network": 2
    },
    "password_manager_enabled": false
  },
  "credentials_enable_service": false,
  "autofill": { "profile_enabled": false, "credit_card_enabled": false },
  "translate": { "enabled": false },
  "spellcheck": { "use_spelling_service": false },
  "browser": { "check_default_browser": false }
}
JSON
}

# The same for Firefox, whose settings are in user.js: Firefox reads it at every start, so it's written
# at every start too (and changes made in the window's settings to these don't stay). Its translating
# is on the computer, so only its offer is turned off; its chatbot, which sends text to other sites,
# is turned off. Also no welcome pages, telemetry or studies.
make_firefox_profile() {
    mkdir -p "$FIREFOX_PROFILE_DIR"
    chmod 700 "$FIREFOX_PROFILE_DIR"
    cat > "$FIREFOX_PROFILE_DIR/user.js" <<'JS'
// Written by EteSync Desktop's launcher (etesync-desktop) at every start
user_pref("permissions.default.geo", 2);
user_pref("permissions.default.camera", 2);
user_pref("permissions.default.microphone", 2);
user_pref("permissions.default.desktop-notification", 2);
user_pref("permissions.default.xr", 2);
// (programs on this computer, and devices of the local network, for pages of other sites: the app is
// on localhost, which reaches its server on either without these)
user_pref("permissions.default.loopback-network", 2);
user_pref("permissions.default.local-network", 2);
user_pref("permissions.default.localhost", 2);
user_pref("signon.rememberSignons", false);
user_pref("signon.autofillForms", false);
user_pref("signon.generation.enabled", false);
user_pref("browser.formfill.enable", false);
user_pref("extensions.formautofill.addresses.enabled", false);
user_pref("extensions.formautofill.creditCards.enabled", false);
user_pref("xpinstall.enabled", false);
user_pref("extensions.autoDisableScopes", 15);
user_pref("browser.translations.automaticallyPopup", false);
user_pref("browser.ml.chat.enabled", false);
user_pref("extensions.pocket.enabled", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("startup.homepage_welcome_url", "");
user_pref("startup.homepage_welcome_url.additional", "");
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.startup.page", 0);
// (after Firefox was ended abnormally, no tab that offers to restore the old one: the app keeps its own data)
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.newtabpage.enabled", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("datareporting.usage.uploadEnabled", false);
user_pref("app.shield.optoutstudies.enabled", false);
user_pref("app.normandy.enabled", false);
JS
}

open_window() {
    # A browser that can open it in its own window (an "app" window, without tabs and address bar)
    local browser="${BROWSER:-}" b
    if [ -z "$browser" ]; then
        for b in chromium-browser chromium google-chrome-stable google-chrome brave-browser microsoft-edge firefox; do
            if command -v "$b" >/dev/null 2>&1; then
                browser="$b"
                break
            fi
        done
    fi
    # In a profile of its own, the window runs in a browser of its own, so these leave out what it
    # doesn't need: a spare page process kept ready, more than the window's two (the app and the
    # window's frame), and background downloads, updates, sync, translation, casting and the
    # back/forward cache. They keep the profile, so the app's data stays. (In the shared profile, a
    # browser that runs already opens the window, and doesn't take them.)
    local low_memory=()
    if [ "${LOW_MEMORY:-1}" != "0" ]; then
        low_memory=(--renderer-process-limit=2 --disable-background-networking --disable-component-update --disable-sync --disable-default-apps --disable-features=SpareRendererForSitePerProcess,Translate,OptimizationHints,MediaRouter,BackForwardCache)
    fi
    local profile=()
    case "$(basename "${browser:-xdg-open}")" in
        chromium*|google-chrome*|brave*|microsoft-edge*)
            if [ "$PROFILE" = "own" ]; then
                make_profile
                profile=(--user-data-dir="$PROFILE_DIR" --disable-extensions --no-first-run --no-default-browser-check)
            fi
            exec "$browser" "${profile[@]}" "${low_memory[@]}" --app="$URL" ;;
        firefox*)
            # (when the window's Firefox runs already, it opens the window, and the usual one isn't
            # disturbed)
            if [ "$PROFILE" = "own" ]; then
                make_firefox_profile
                profile=(--profile "$FIREFOX_PROFILE_DIR")
            fi
            exec "$browser" "${profile[@]}" --new-window "$URL" ;;
        *) exec xdg-open "$URL" ;;
    esac
}

case "${1:-}" in
    --start) start ;;
    --stop) stop ;;
    --status) server ;;
    "") start; open_window ;;
    *) echo "Unknown option $1 (there are --start, --stop and --status)" >&2; exit 1 ;;
esac
